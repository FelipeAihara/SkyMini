/dts-v1/;

#include <espressif/esp32c6/esp32c6.dtsi>
#include "esp32c6_supermini-pinctrl.dtsi"
#include <zephyr/dt-bindings/input/input-event-codes.h>
#include <espressif/partitions_0x0_default.dtsi>

/ {
    model = "ESP32C6-SUPERMINI HP CORE";
    compatible = "espressif,esp32c6";

    aliases {
        watchdog0 = &wdt0;
        led-0 = &blue_led_0;
        uart-0 = &uart0;
        sw0 = &user_button1;
    };

    chosen {
		zephyr,sram = &sramhp;
		zephyr,console = &usb_serial;
		zephyr,shell-uart = &usb_serial;
		zephyr,flash = &flash0;
		zephyr,code-partition = &slot0_partition;
		zephyr,ieee802154 = &ieee802154;
	};

    gpio_keys {
		compatible = "gpio-keys";

		user_button1: button_1 {
			label = "User SW1";
			gpios = <&gpio0 9 (GPIO_PULL_UP | GPIO_ACTIVE_LOW)>;
			zephyr,code = <INPUT_KEY_0>;
		};
	};

	leds {
		compatible = "gpio-leds";

		blue_led_0: led_0 {
			gpios = <&gpio0 8 GPIO_ACTIVE_LOW>;
			label = "Blue LED 0";
		};
	};
};

&flash0 {
	reg = <0x0 DT_SIZE_M(4)>;
	ranges = <0x0 0x0 DT_SIZE_M(4)>;
};

&gpio0 {
	status = "okay";
};

&wdt0 {
	status = "okay";
};

&esp32_bt_hci {
	status = "okay";
};

&wifi {
	status = "okay";
};

&usb_serial {
	status = "okay";
};

&i2c0 {
	status = "okay";
	clock-frequency = <I2C_BITRATE_FAST>;
	pinctrl-0 = <&i2c0_default>;
	pinctrl-names = "default";

	bmi160: bmi160@68 {
		compatible = "bosch,bmi160";
		/* Troque para 0x69 se o pino SDO/SA0 do seu módulo estiver em nível alto. */
		reg = <0x68>;
	};
};

&ledc0 {
	status = "okay";
	pinctrl-0 = <&ledc0_default>;
	pinctrl-names = "default";
	#address-cells = <1>;
	#size-cells = <0>;

	channel0@0 {
		reg = <0x0>;
		timer = <0>;
	};

	channel1@1 {
		reg = <0x1>;
		timer = <0>;
	};

	channel2@2 {
		reg = <0x2>;
		timer = <0>;
	};

	channel3@3 {
		reg = <0x3>;
		timer = <0>;
	};
};